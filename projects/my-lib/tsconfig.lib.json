{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "lib": ["dom", "es2022"]
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  },
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
